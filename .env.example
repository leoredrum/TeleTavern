# Telegram Bot token (from @BotFather)
TELEGRAM_BOT_TOKEN=replace_me_with_real_token

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=fredrezones55/Qwen3.6-35B-A3B-Uncensored-HauhauCS-Aggressive

# Character card (PNG with embedded chara chunk, or V2/V3 JSON)
CHARACTER_PATH=./characters/penelope/Penelope3.png

# SQLite session DB
DB_PATH=./data/sessions.db

# Optional: shared conversation state (multi-bot awareness)
# SHARED_DB_PATH=./data/conversation_state.db

# Conversation tuning
HISTORY_LIMIT_MESSAGES=40
MAX_TOKENS=1024

# Persona labels
CHAR_LABEL=Penelope
USER_LABEL=Friend

# Locale
REPLY_LANGUAGE=Chinese

# Admin user IDs (comma-separated) for /debug and privileged commands
ADMIN_IDS=

# Content flags
NSFW_ENABLED=true

# Phase 1 debug — when set to non-empty, logs full PromptItem breakdown
DEBUG_PROMPT=