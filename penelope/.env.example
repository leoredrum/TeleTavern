# Penelope bot — env template. Copy to .env and fill in real values.
#
# !! NEVER COMMIT .env — it contains the real bot token. .gitignore blocks it. !!
#
# Note on field names: config.py reads OLLAMA_URL and OLLAMA_MODEL
# (not OLLAMA_BASE_URL / MODEL_NAME). We keep the field names you asked for
# here, but the bot will fall back to the built-in defaults until you also set
# OLLAMA_URL and OLLAMA_MODEL. See monorepo root .env.example for the full list.

# --- Required: Telegram ---
TELEGRAM_BOT_TOKEN=

# --- Character card ---
CHARACTER_PATH=/Users/leo/Documents/telegramtavern/penelope/data/Penelope3.png

# --- SQLite session store ---
DB_PATH=/Users/leo/Documents/telegramtavern/penelope/data/chat.db

# --- Cross-bot shared state (relay / duet coordination) ---
SHARED_DB_PATH=/Users/leo/Documents/telegramtavern/penelope/data/shared.db

# --- Reply language ---
REPLY_LANGUAGE=zh-CN

# --- Model ---
MODEL_NAME=fredrezones55/Qwen3.6-35B-A3B-Uncensored-HauhauCS-Aggressive:latest

# --- Ollama endpoint ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
